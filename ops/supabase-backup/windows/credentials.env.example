# Copy to:
#   %LOCALAPPDATA%\quore-supabase-backup\credentials.env
# On PowerShell:
#   copy windows\credentials.env.example $env:LOCALAPPDATA\quore-supabase-backup\credentials.env

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# URL-encode special chars in password (@ -> %40)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Windows paths (forward slashes OK)
BACKUP_ROOT=C:/Users/YOUR_WINDOWS_USER/AppData/Local/quore-supabase-backup/backups
STATE_DIR=C:/Users/YOUR_WINDOWS_USER/AppData/Local/quore-supabase-backup/backups/state
REPORT_DIR=C:/Users/YOUR_WINDOWS_USER/AppData/Local/quore-supabase-backup/backups/reports
LOG_DIR=C:/Users/YOUR_WINDOWS_USER/AppData/Local/quore-supabase-backup/backups/logs

PG_DUMP_BIN=C:/Program Files/PostgreSQL/18/bin/pg_dump.exe
