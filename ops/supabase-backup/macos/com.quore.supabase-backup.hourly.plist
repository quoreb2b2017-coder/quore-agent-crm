<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.quore.supabase-backup.hourly</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BIN__</string>
    <string>__RUN_JS__</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__TOOLKIT_ROOT__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>BACKUP_ENV_FILE</key>
    <string>__CREDENTIALS_ENV__</string>
    <key>PATH</key>
    <string>__PATH__</string>
  </dict>

  <!-- Every hour -->
  <key>StartInterval</key>
  <integer>3600</integer>

  <!-- Also run after load (login / agent start) for missed recovery -->
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__LOG_DIR__/launchd-hourly.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/launchd-hourly.err.log</string>

  <key>Nice</key>
  <integer>5</integer>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
