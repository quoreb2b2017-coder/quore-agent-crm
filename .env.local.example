# =============================================================================
# quore-agent-crm — copy to .env.local for local dev
#   cp .env.local.example .env.local
#
# Vercel: Project → Settings → Environment Variables
#   Add every variable in "Required on Vercel" (Production + Preview).
#   Socket vars are optional until you host server/socket-server.ts elsewhere.
# =============================================================================

# --- Required on Vercel (and local) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Payslip cron (/api/cron/salary-slips). Vercel Cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate-a-long-random-string

# Payslip PDF header (optional — defaults exist in src/lib/company.ts)
COMPANY_NAME=Quore B2B
COMPANY_LEGAL_NAME=Quore B2b Private Limited
COMPANY_ADDRESS=Omicron commerz, 8th floor office 804, Z Lane, Mundhwa Pune India
COMPANY_TAGLINE=

# --- Local dev only (npm run dev runs Next + socket together) ---
SOCKET_PORT=3002
NEXT_PUBLIC_SOCKET_URL=http://localhost:3002
SOCKET_INTERNAL_URL=http://127.0.0.1:3002

# --- Optional: separate socket host (Railway / Render) for production ---
# Leave NEXT_PUBLIC_SOCKET_URL unset on Vercel until socket is deployed.
# Then set BOTH to your public socket URL, e.g. https://your-app.up.railway.app
# NEXT_PUBLIC_SOCKET_URL=https://your-socket-host.example.com
# SOCKET_INTERNAL_URL=https://your-socket-host.example.com
# SOCKET_SECRET=optional-shared-secret-between-next-and-socket
