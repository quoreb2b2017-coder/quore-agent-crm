NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix with NEXT_PUBLIC_. Used for admin bootstrap
# scripts and privileged server routes (payroll, activity ingest).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Socket.io real-time notifications (server/socket-server.ts)
SOCKET_PORT=3002
NEXT_PUBLIC_SOCKET_URL=http://localhost:3002
SOCKET_INTERNAL_URL=http://127.0.0.1:3002

# Shown on generated payslips (employer name, not the app name).
COMPANY_NAME=Quore B2B
COMPANY_LEGAL_NAME=Quore B2b Private Limited
COMPANY_ADDRESS=Omicron commerz, 8th floor office 804, Z Lane, Mundhwa Pune India
COMPANY_TAGLINE=

# Optional. Used by /api/cron/salary-slips (payslips generate on the 10th).
# Authorization: Bearer CRON_SECRET
# CRON_SECRET=a-long-random-string
# Optional. Falls back to SUPABASE_SERVICE_ROLE_KEY.
# SOCKET_SECRET=a-long-random-string
